<?xml version="1.0"?>
<ruleset name="Persian Kit">
    <description>WordPress security and i18n sniffs. Code style follows PSR-12, not WPCS formatting.</description>

    <file>persian-kit.php</file>
    <file>uninstall.php</file>
    <file>src</file>
    <file>views</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <config name="minimum_wp_version" value="6.8"/>
    <config name="testVersion" value="8.1-"/>

    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="persian-kit"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.WP.DeprecatedFunctions"/>
    <rule ref="WordPress.WP.AlternativeFunctions"/>
    <rule ref="WordPress.PHP.DontExtract"/>
</ruleset>

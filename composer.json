{
    "name": "eram/persian-kit",
    "description": "A modular Persian (Farsi) language toolkit for WordPress",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://eram.dev/fa/projects/persian-kit/",
    "authors": [
        {
            "name": "Eram",
            "homepage": "https://eram.dev/fa/"
        },
        {
            "name": "Navid Kashani"
        }
    ],
    "support": {
        "issues": "https://github.com/eramhq/persian-kit/issues",
        "source": "https://github.com/eramhq/persian-kit",
        "docs": "https://eram.dev/fa/docs/persian-kit/overview/"
    },
    "require": {
        "php": ">=8.1",
        "eram/daynum": "^1.0@beta",
        "eram/abzar": "^0.8@beta"
    },
    "require-dev": {
        "veronalabs/wp-scoper": "^1.4.2",
        "phpunit/phpunit": "^10.5.65",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6.15",
        "yoast/phpunit-polyfills": "^2.0.5",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "php-stubs/woocommerce-stubs": "^11.1"
    },
    "autoload": {
        "psr-4": {
            "PersianKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PersianKit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "wp-scoper": {
            "namespace_prefix": "PersianKit\\Dependencies",
            "packages": [
                "eram/daynum",
                "eram/abzar"
            ],
            "target_directory": "packages",
            "delete_vendor_packages": false,
            "exclude_directories": [
                "views",
                "resources",
                "public"
            ]
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "test:integration:setup": "bash tests/bin/setup-integration-tests.sh",
        "test:integration": "WP_TESTS_DIR=.wordpress-tests/wordpress-develop/tests/phpunit php .wordpress-tests/bin/phpunit-9.6.23.phar -c phpunit-integration.xml.dist --testsuite integration --testdox",
        "test:integration:polylang": "PERSIAN_KIT_TESTS_MULTILINGUAL=1 WP_TESTS_DIR=.wordpress-tests/wordpress-develop/tests/phpunit php .wordpress-tests/bin/phpunit-9.6.23.phar -c phpunit-integration.xml.dist --testsuite integration --group polylang --testdox",
        "test:integration:sources": "PERSIAN_KIT_TESTS_SOURCES=1 WP_TESTS_DIR=.wordpress-tests/wordpress-develop/tests/phpunit php .wordpress-tests/bin/phpunit-9.6.23.phar -c phpunit-integration.xml.dist --testsuite integration --group sources --testdox",
        "post-install-cmd": [
            "@composer wp-scope",
            "@php scripts/prepare-bundled-libraries.php"
        ],
        "post-update-cmd": [
            "@composer wp-scope",
            "@php scripts/prepare-bundled-libraries.php"
        ],
        "phpstan": "phpstan analyse --memory-limit=2G",
        "phpcs": "phpcs",
        "docs:check": "node scripts/check-docs.mjs",
        "docs:examples": "node scripts/check-docs.mjs --examples"
    },
    "config": {
        "platform-check": false,
        "platform": {
            "php": "8.1"
        },
        "allow-plugins": {
            "veronalabs/wp-scoper": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}

msgid "Posts that would change, by post type"
msgstr "نوشته‌هایی که تغییر می‌کنند، به تفکیک نوع نوشته"

#: views/admin/partials/char-normalization-settings.php:165
msgid "Post type"
msgstr "نوع نوشته"

#: views/admin/partials/char-normalization-settings.php:166

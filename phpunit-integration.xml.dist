<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    bootstrap="tests/bootstrap.php"
    backupGlobals="false"
    colors="true"
    verbose="true"
    beStrictAboutTestsThatDoNotTestAnything="true"
>
    <!-- WordPress's test library runs on PHPUnit 9.6, so this file keeps the 9.6 schema. -->
    <testsuites>
        <testsuite name="integration">
            <directory suffix="Test.php">tests/Integration</directory>
        </testsuite>
    </testsuites>

    <!-- Polylang's tests run on their own: composer test:integration:polylang.
         The tests against Parsi Date, Persian WooCommerce and its shipping
         plugin too: composer test:integration:sources. -->
    <groups>
        <exclude>
            <group>polylang</group>
            <group>sources</group>
        </exclude>
    </groups>

    <coverage>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </coverage>
</phpunit>
